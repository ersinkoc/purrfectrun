    "@react-three/drei": "10.7.9",
    "lucide-react": "1.55.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
